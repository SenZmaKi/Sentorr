---
import Group from './Group.astro';
import SectionHeader from './SectionHeader.astro';
import Tile from './Tile.astro';

const features = [
  { icon: 'play_circle', outlined: true, title: 'Plays while it downloads', subtitle: 'Starts after a short buffer; seeking fetches that part first' },
  { icon: 'travel_explore', title: 'Finds the right torrent', subtitle: 'Matched to the exact title, ranked by quality, size and seeders' },
  { icon: 'picture_in_picture_alt', title: 'A proper player', subtitle: 'Subtitles, speed, mini player, pop-out and YouTube’s shortcuts' },
  { icon: 'download_for_offline', outlined: true, title: 'Downloads', subtitle: 'Movies, episodes or whole seasons, kept for offline' },
  { icon: 'notifications', outlined: true, title: 'Follow your shows', subtitle: 'Hear when new episodes air, or have them downloaded' },
  { icon: 'vpn_lock', outlined: true, title: 'Your network, your rules', subtitle: 'Speed limits, a proxy, and binding to your VPN' },
];
---

<section>
  <SectionHeader id="features" icon="widgets" title="What Sentorr does" subtitle="Everything between choosing a title and the first frame" />
  <Group class="feature-group">
    {features.map((f) => <Tile icon={f.icon} outlined={f.outlined} title={f.title} subtitle={f.subtitle} />)}
  </Group>
</section>

<style>
  /* Two columns of rows on one surface, divided like the app's settings rows. */
  :global(.feature-group .rows) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  :global(.feature-group .rows > :nth-child(-n + 2)) { border-top: 0; }
  :global(.feature-group .rows > :nth-child(odd)) { border-right: 1px solid var(--border-subtle); }
  @media (max-width: 759px) {
    :global(.feature-group .rows) { grid-template-columns: 1fr; }
    :global(.feature-group .rows > :nth-child(2)) { border-top: 1px solid var(--border-subtle); }
    :global(.feature-group .rows > :nth-child(odd)) { border-right: 0; }
  }
</style>

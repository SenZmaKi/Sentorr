---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';

// The stages the app's player names on its opening cover, before the first frame.
const steps = [
  { icon: 'search', title: 'Pick a title', body: 'Browse what’s trending and new, or search for anything.' },
  { icon: 'travel_explore', title: 'Finding a torrent', body: 'Sources are searched and the best release for that exact title is chosen.' },
  { icon: 'hub', title: 'Connecting to peers', body: 'Sentorr joins the swarm and asks for the opening of the file first.' },
  { icon: 'play_arrow', title: 'Playing', body: 'Watch while the rest downloads. Seeking jumps the queue.' },
];
---

<section>
  <SectionHeader icon="route" title="From click to playback" subtitle="What happens after you press Play, usually in seconds" />
  <ol class="steps raised">
    {steps.map((step, index) => (
      <li class="step">
        <div class="marker">
          <span class:list={['node', { last: index === steps.length - 1 }]}><Icon name={step.icon} /></span>
          <span class="rail-line inset" aria-hidden="true"></span>
        </div>
        <div class="text">
          <p class="technical muted">0{index + 1}</p>
          <h3 class="t-label">{step.title}</h3>
          <p class="t-small secondary">{step.body}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 24px;
  }
  .step { display: grid; gap: 16px; }
  .marker { display: flex; align-items: center; }
  .node {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--surface-inset);
    color: var(--fg-secondary);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  /* The last stage is the payoff: it takes the action fill, like Play. */
  .node.last { background: var(--action); color: var(--on-action); box-shadow: var(--shadow-raised); }
  .rail-line { flex: 1; height: 4px; margin: 0 8px; border-radius: 2px; }
  .step:last-child .rail-line { visibility: hidden; }
  .text { display: grid; gap: 2px; padding-right: 24px; }
  h3 { font-weight: 600; }

  /* Tablets and phones turn the track vertical, nodes down the leading edge. */
  @media (max-width: 959px) {
    .steps { grid-template-columns: 1fr; padding: 16px; }
    .step { grid-template-columns: 40px 1fr; gap: 16px; }
    .marker { flex-direction: column; }
    .rail-line { width: 4px; height: auto; min-height: 24px; margin: 8px 0; }
    .step:last-child .rail-line { display: none; }
    .text { padding: 0 0 16px; }
  }
</style>
